# --- Clerk (https://dashboard.clerk.com → API keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Webhook endpoint: <your-domain>/api/webhooks/clerk — subscribe to user.created,
# user.updated, user.deleted; paste the signing secret here:
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register

# Recommended: in Clerk → Sessions → Customize session token, add
#   { "publicMetadata": "{{user.public_metadata}}" }
# so the middleware can gate role/status without a DB query.

# --- Supabase (data only — auth stays with Clerk) ---
# Run supabase/schema.sql, then optionally supabase/seed.sql in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Anthropic (Reconly Assist) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-sonnet-4-6
# ASSIST_MODEL=claude-sonnet-4-6
